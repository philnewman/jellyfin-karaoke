# Copy this file to .env (same folder) and fill in the first two lines.

# Address of your Jellyfin server, as this machine reaches it.
# On a Mac, a LAN address (http://192.168.x.x:8096) only works for the login item after
# Python is allowed under System Settings > Privacy & Security > Local Network;
# a public https address works without that.
JELLYFIN_URL=http://jellyfin.local:8096

# Dashboard > API Keys > New API Key
JELLYFIN_API_KEY=paste-your-api-key-here

# CPU threads for separation. On a 6-core Intel Mac, 4 threads take about 2.2 minutes
# per minute of music.
THREADS=4

# Memory guards. Separation peaks at about 1.1 GB.
MAX_MEMORY_MB=2500
MIN_FREE_MB=3000

# Optional: only process songs between these hours (24h clock), e.g. 23-7.
# ACTIVE_HOURS=23-7
