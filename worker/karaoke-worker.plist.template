<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Filled in and copied to ~/Library/LaunchAgents by install-mac.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.karaoke-worker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__RUN_SCRIPT__</string>
    </array>
    <!-- Start at login, and restart it if it ever exits. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <!-- Lower priority so it never competes with what you are doing. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>
</dict>
</plist>
